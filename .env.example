# Copy to .env at the repo root and fill in. .env is git-ignored.
# Examples load this file via python-dotenv find_dotenv(), so one root .env
# serves every examples/<track> project.

# Required: OpenAI API key for runnable examples.
OPENAI_API_KEY=sk-...

# Model used by every example. gpt-4o-mini is a cheap, capable default.
MODEL=gpt-4o-mini

# LangSmith tracing + evaluation (needed for the 03-langsmith track; optional elsewhere).
# Turning tracing on traces every LangChain/LangGraph run with no code change.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=learn-harness
